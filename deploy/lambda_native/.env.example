# Environment for the Lambda emotion selection image.
#
# NEVER commit real values and never bake them into the image. GEMINI_API_KEY is
# supplied at deploy time as a Lambda environment variable, or read from AWS
# Secrets Manager — see docs/LambdaEmotionDeployment.md.

# --- secret: set in Lambda console / CLI / Secrets Manager, not here ---------
GEMINI_API_KEY=

# --- models (baked into the image as defaults; override only to change models)
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# --- native query settings ---------------------------------------------------
# These reproduce the 91-record evaluation. Changing them changes retrieval
# behaviour and invalidates that measurement.
LIGHTRAG_MODE=hybrid
LIGHTRAG_TOP_K=8
LIGHTRAG_CHUNK_TOP_K=8

# --- artifact paths (already set by the Dockerfile) --------------------------
LIGHTRAG_ARTIFACT_DIR=/var/task/emotion_artifact
LIGHTRAG_WORK_DIR=/tmp/emotion-artifact

# --- operations --------------------------------------------------------------
LOG_LEVEL=INFO

# Optional shared secret. When set, Function URL / API Gateway requests must
# send it as the X-Emotion-Api-Token header. Leave empty to rely on IAM auth.
EMOTION_API_TOKEN=
